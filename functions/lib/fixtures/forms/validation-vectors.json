{
  "about": "One answer to one field of a form, and what both the server (functions/lib/forms.js validateAnswers) and the page runtime (templates/_shared/rv-forms.js RevampForms.validate) must make of it: the cleaned value (\"value\"), the exact message (\"error\"), or nothing stored for an empty optional answer (\"omitted\"). Spec 'Multi-form registration' section 1.2. A mapped field's cleaned value is the registration's own column (an empty optional one is '').",
  "fields": {
    "name": { "id": "name", "type": "text", "label": "Full name", "required": true, "placeholder": "", "help": "" },
    "email": { "id": "email", "type": "email", "label": "Work email", "required": true, "placeholder": "", "help": "" },
    "phone": { "id": "phone", "type": "phone", "label": "Mobile number", "required": true, "placeholder": "", "help": "" },
    "phoneOptional": { "id": "phone", "type": "phone", "label": "Mobile number", "required": false, "placeholder": "", "help": "" },
    "company": { "id": "company", "type": "text", "label": "Company", "required": true, "placeholder": "", "help": "" },
    "nickname": { "id": "nickname", "type": "text", "label": "Nickname", "required": false, "placeholder": "", "help": "" },
    "why": { "id": "why", "type": "textarea", "label": "Why attend", "required": true, "placeholder": "", "help": "" },
    "team": { "id": "team", "type": "number", "label": "Team size", "required": true, "placeholder": "", "help": "" },
    "linkedin": { "id": "linkedin", "type": "url", "label": "LinkedIn profile", "required": true, "placeholder": "", "help": "" },
    "arrival": { "id": "arrival", "type": "date", "label": "Arrival date", "required": true, "placeholder": "", "help": "" },
    "tier": { "id": "tier", "type": "select", "label": "Partnership interest", "required": true, "placeholder": "", "help": "", "options": ["Exhibitor", "Other"] },
    "meal": { "id": "meal", "type": "radio", "label": "Meal", "required": true, "placeholder": "", "help": "", "options": ["Veg", "Non-veg"] },
    "topics": { "id": "topics", "type": "multiselect", "label": "Topics", "required": true, "placeholder": "", "help": "", "options": ["AI", "Cloud", "Data"] },
    "consent": { "id": "consent", "type": "checkbox", "label": "I agree to the terms", "required": true, "placeholder": "", "help": "" },
    "newsletter": { "id": "newsletter", "type": "checkbox", "label": "Newsletter", "required": false, "placeholder": "", "help": "" },
    "country": { "id": "country", "type": "country", "label": "Country", "required": true, "placeholder": "", "help": "" }
  },
  "vectors": [
    { "field": "name", "value": "", "expect": { "error": "Please enter your name." } },
    { "field": "name", "value": "  Asha   Rao ", "expect": { "value": "Asha Rao" } },
    { "field": "name", "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA", "expect": { "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" } },
    { "field": "email", "value": "", "expect": { "error": "Please enter your email address." } },
    { "field": "email", "value": "  Asha.Rao@Example.COM ", "expect": { "value": "asha.rao@example.com" } },
    { "field": "email", "value": "asha@example", "expect": { "error": "Please enter a valid email address." } },
    { "field": "email", "value": "asha example.com", "expect": { "error": "Please enter a valid email address." } },
    { "field": "phone", "value": "", "expect": { "error": "Please fill in Mobile number." } },
    { "field": "phone", "value": "987654", "expect": { "error": "Please enter a valid phone number." } },
    { "field": "phone", "value": "9876543", "expect": { "value": "9876543" } },
    { "field": "phone", "value": "+91 98765 43210", "expect": { "value": "+91 98765 43210" } },
    { "field": "phone", "value": "123456789012345", "expect": { "value": "123456789012345" } },
    { "field": "phone", "value": "1234567890123456", "expect": { "error": "Please enter a valid phone number." } },
    { "field": "phone", "value": "call 98765 43210", "expect": { "error": "Please enter a valid phone number." } },
    { "field": "phoneOptional", "value": "", "expect": { "value": "" } },
    { "field": "phoneOptional", "value": "12", "expect": { "error": "Please enter a valid phone number." } },
    { "field": "company", "value": "   ", "expect": { "error": "Please fill in Company." } },
    { "field": "nickname", "value": "", "expect": { "omitted": true } },
    { "field": "nickname", "value": 42, "expect": { "value": "42" } },
    { "field": "nickname", "value": "  two\tparts  ", "expect": { "value": "two parts" } },
    { "field": "why", "value": "line one\r\nline two  ", "expect": { "value": "line one\nline two" } },
    { "field": "why", "value": "", "expect": { "error": "Please fill in Why attend." } },
    { "field": "team", "value": "1e3", "expect": { "value": 1000 } },
    { "field": "team", "value": "abc", "expect": { "error": "Please enter a number for Team size." } },
    { "field": "team", "value": " 42 ", "expect": { "value": 42 } },
    { "field": "team", "value": 12.5, "expect": { "value": 12.5 } },
    { "field": "team", "value": "1e13", "expect": { "error": "Please enter a number for Team size." } },
    { "field": "team", "value": "", "expect": { "error": "Please fill in Team size." } },
    { "field": "linkedin", "value": "linkedin.com/in/asha", "expect": { "value": "https://linkedin.com/in/asha" } },
    { "field": "linkedin", "value": "https://www.example.com/a?b=c", "expect": { "value": "https://www.example.com/a?b=c" } },
    { "field": "linkedin", "value": "not a web address", "expect": { "error": "Please enter a web address for LinkedIn profile, like https://example.com." } },
    { "field": "linkedin", "value": "ftp://example.com", "expect": { "error": "Please enter a web address for LinkedIn profile, like https://example.com." } },
    { "field": "linkedin", "value": "localhost", "expect": { "error": "Please enter a web address for LinkedIn profile, like https://example.com." } },
    { "field": "arrival", "value": "2026-02-30", "expect": { "error": "Please enter a valid date for Arrival date." } },
    { "field": "arrival", "value": "2024-02-29", "expect": { "value": "2024-02-29" } },
    { "field": "arrival", "value": "2023-02-29", "expect": { "error": "Please enter a valid date for Arrival date." } },
    { "field": "arrival", "value": "1899-12-31", "expect": { "error": "Please enter a valid date for Arrival date." } },
    { "field": "arrival", "value": "2101-01-01", "expect": { "error": "Please enter a valid date for Arrival date." } },
    { "field": "arrival", "value": "19-11-2026", "expect": { "error": "Please enter a valid date for Arrival date." } },
    { "field": "arrival", "value": "", "expect": { "error": "Please fill in Arrival date." } },
    { "field": "tier", "value": "Exhibitor", "expect": { "value": "Exhibitor" } },
    { "field": "tier", "value": "Gold", "expect": { "error": "Please choose one of the options for Partnership interest." } },
    { "field": "tier", "value": "", "expect": { "error": "Please choose Partnership interest." } },
    { "field": "meal", "value": " Veg ", "expect": { "value": "Veg" } },
    { "field": "meal", "value": "Vegan", "expect": { "error": "Please choose one of the options for Meal." } },
    { "field": "topics", "value": ["AI", "AI", "Data"], "expect": { "value": ["AI", "Data"] } },
    { "field": "topics", "value": ["AI", "Blockchain"], "expect": { "error": "Please choose one of the options for Topics." } },
    { "field": "topics", "value": [], "expect": { "error": "Please choose at least one option for Topics." } },
    { "field": "topics", "value": "Cloud", "expect": { "value": ["Cloud"] } },
    { "field": "consent", "value": false, "expect": { "error": "Please tick I agree to the terms to continue." } },
    { "field": "consent", "value": true, "expect": { "value": true } },
    { "field": "consent", "value": "on", "expect": { "value": true } },
    { "field": "newsletter", "value": false, "expect": { "value": false } },
    { "field": "country", "value": "India", "expect": { "value": "India" } },
    { "field": "country", "value": "Atlantis", "expect": { "error": "Please choose one of the options for Country." } },
    { "field": "country", "value": "", "expect": { "error": "Please choose Country." } }
  ]
}

# Loaded automatically by Firebase Functions (v2) at deploy/runtime — not secret, just project config.
# GEMINI_API_KEY is NOT here: it's a real secret, set via `firebase functions:secrets:set GEMINI_API_KEY`
# instead (see functions/index.js, which binds it from Secret Manager).
FIREBASE_STORAGE_BUCKET=revamp-cms.firebasestorage.app

# Copy to tools/.env.local (gitignored) and fill in. node tools/serve.js reads this file on startup.

GEMINI_API_KEY=

# Firebase — service account for a project with Firestore + Storage enabled.
# Either paste the key file's JSON as one line, or point at the file on disk — not both.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_STORAGE_BUCKET=

{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "tools/**",
      "payment/html_version/node_modules/**",
      "*.docx",
      "memory.md",
      "PRD.md",
      "Design.md",
      "architecture.md",
      "firestore.rules",
      "firestore.indexes.json",
      "storage.rules",
      "server.js",
      "package.json",
      "package-lock.json",
      "apphosting.yaml"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api" }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

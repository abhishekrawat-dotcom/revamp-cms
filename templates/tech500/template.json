{
  "id": "tech500",
  "name": "TECH500",
  "source": "https://cio.economictimes.indiatimes.com/tech-500-summit",
  "briefReady": true,
  "briefCategory": "CIO / enterprise tech leadership",

  "shared": ["et-global.css", "et-animate.css", "et-platform.css"],
  "fonts": [
    "https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800&display=swap",
    "https://fonts.googleapis.com/css2?family=Playfair%20Display:wght@100;200;300;400;500;600;700;800&display=swap"
  ],
  "theme": "theme.css",
  "design": {
    "notes": "What the editor's theme controls act on. headingFontVar = the variable most headings read (the event theme sets --heading-font-family-v2 = Fraunces; --heading-font-family = Playfair is only for a few labels). headings/buttons/cards = selectors for the heading, corner-radius controls. swatches = theme colours offered besides the template's own.",
    "headingFontVar": "--heading-font-family-v2",
    "headings": ".page_hdng2 h2, .page_hdng4 h1, .page_hdng4 h2, .page_hdng5 h1, .page_hdng5 h2",
    "buttons": "a.book-btn, .agenda-cta, .strategic-influence-btn",
    "cards": ".why-now-card, .agenda-card, .summit-spotlight-card, .power-chain-insight, .contacts .contact-box-wrapper .contact-box",
    "swatches": ["#0F6F5C", "#1F4FD8", "#8A5A9E", "#9C6B14", "#191B1F"]
  },
  "editorFonts": {
    "Fraunces": "\"Fraunces\", serif",
    "Playfair Display": "Playfair Display, Arial, sans-serif",
    "Inter": "Inter, Arial, sans-serif"
  },

  "body": {
    "id": "cio",
    "class": "microsite product_microsite heading-style-3 color_black web_view_ et_cio",
    "classNotes": "single-header is added at runtime by ET's header script on the live page; it sets #banner padding-top to 160px (≥768px) to clear ET's header. Revisit when the shared header design arrives.",
    "style": {
      "--default-color": "rgb(25 27 31)",
      "--bg-color": "rgba(255, 255, 255, 1)",
      "--bg-spacing": "70px 0",
      "--para-font-size": "16px",
      "--theme-color": "rgba(216, 21, 30, 1)",
      "--primary-font-size": "48px",
      "--secondary-font-size": "16px",
      "--body-color": "rgba(0, 0, 0, 1)",
      "font-size": "16px",
      "--nav-text-color": "rgba(255, 255, 255, 1)",
      "--nav-bg-color": "rgba(0, 0, 0, 1)",
      "--body-font-family": "Inter, Arial, sans-serif",
      "--heading-font-family": "Playfair Display, Arial, sans-serif",
      "--heading-color": "rgba(13, 13, 15, 1)"
    }
  },

  "content": {
    "notes": "How Create Event's content fills this template (editor-fill.js has the rule reference). intro = where this design puts the section text every Create Event section carries (sub heading, heading, paragraph, pointers, image/video, button) — only the slots TECH500's design has; the rest isn't shown here. from = a Create Event library id (step 3) or event (step 1). Create Event sections with no entry here (speakers, agenda, partners, …) are left out and the editor says so. Every list rule uses empty:hide, so a list with nothing in it shows no cards rather than TECH500’s own; the section heading stays so there is still a visible slot to fill. FAQs and contacts are the event's records (Content › FAQ, Content › Contact): each section file holds one neutral model item, and with no records the section is not on the live site. about-us (About ETCIO) has no entry and keeps its own copy deliberately — it is ET CIO’s publisher boilerplate, the same on every ET CIO microsite, not event content a wizard field should own. The banner names the event in words (its headline, or its name) with the tagline under it; an event with a logo shows the logo instead and keeps the words for search engines and screen readers. The banner has one picture, img.banner-bg-image: the event's own banner (an uploaded image, or the flattened image of an uploaded PSD — the PSD's text and button layers do not carry over, this banner has fixed text slots) replaces it, and a video plays over it only when the event supplies a video file of its own. The overview heading reads 'What is <event name>' until the owner writes a heading.",
    "bindNotes": "Elements that show one of the event's own details (Content › Basics) and follow it on every visit (rv-data.js, data-rv-bind). The section files carry the attribute themselves; this list is for pages saved before they did.",
    "bind": [
      { "section": "banner", "sel": "img.logo", "bind": "event.logo" },
      { "section": "banner", "sel": ".icn-box:has(.bi-calendar3)", "bind": "event.date" },
      { "section": "banner", "sel": ".icn-box:has(.bi-geo-alt)", "bind": "event.venue" },
      { "section": "strategic-influence", "sel": ".strategic-influence-meta > span:first-child", "bind": "event.date" },
      { "section": "strategic-influence", "sel": ".strategic-influence-meta > span:last-child", "bind": "event.venue" }
    ],
    "map": [
      { "from": "hero", "section": "banner",
        "aiSkipMedia": "img.banner-bg-image",
        "fill": [
        { "attr": "img.banner-bg-image", "name": "src", "value": "{hero.bannerUrl}", "empty": "keep" },
        { "bgvideo": ".bnr-bg-video", "value": "{hero.video.url}", "poster": "img.banner-bg-image" },
        { "attr": "img.logo", "name": "src", "value": "{event.logo}" },
        { "attr": "img.logo", "name": "alt", "value": "{event.name}" },
        { "show": "img.logo", "if": "{event.logo}" },
        { "text": ".banner-title", "value": "{hero.title|event.name}", "bind": "event.name" },
        { "text": ".banner-tagline", "value": "{hero.tagline}", "empty": "remove" },
        { "text": ".icn-box:has(.bi-calendar3)", "value": "{event.dateLabel|event.date}", "empty": "remove" },
        { "text": ".icn-box:has(.bi-geo-alt)", "value": "{event.location}", "empty": "remove" },
        { "text": ".btn-wrapper .book-btn:not(.btn-outline)", "value": "{hero.cta1}", "empty": "keep" },
        { "text": ".btn-wrapper .book-btn.btn-outline", "value": "{hero.cta2}", "empty": "remove" }
      ] },
      { "from": "event", "section": "strategic-influence", "fill": [
        { "drop": ".strategic-influence-divider", "unless": "{event.dateLabel|event.date}" },
        { "drop": ".strategic-influence-divider", "unless": "{event.location}" },
        { "text": ".strategic-influence-meta > span:first-child", "value": "{event.dateLabel|event.date:day}", "empty": "remove" },
        { "text": ".strategic-influence-meta > span:last-child", "value": "{event.location}", "empty": "remove" }
      ] },
      { "from": "about", "section": "overview",
        "intro": { "subheading": "h2 > span", "heading": { "sel": "h2", "skip": "span" }, "body": ".text-style .col-md-7 > div > p",
                   "points": ".text-style .col-md-7 > div:has(> p)", "media": { "sel": ".text-style.row", "wrap": "col-md-5" } },
        "fill": [
        { "text": "h2 > span", "value": "About {event.name}" },
        { "text": "h2", "skip": "span", "value": "What is {event.name}" }
      ] },
      { "from": "priorities", "section": "why-now",
        "intro": { "subheading": ".why-now-kicker strong", "heading": ".why-now-main .page_hdng4 h2", "body": ".why-now-insight > p" },
        "fill": [
        { "list": ".why-now-card", "items": "priorities.items", "require": "{t}{d}", "empty": "hide", "fill": [
          { "text": ".why-now-card__number", "value": "{##}" },
          { "text": "h4", "value": "{t}" },
          { "text": "p", "value": "{d}" }
        ] }
      ] },
      { "from": "stats", "section": "summit-spotlight",
        "intro": { "subheading": "h2 > span", "heading": { "sel": "h2", "skip": "span" } },
        "fill": [
        { "list": ".summit-spotlight-card", "items": "stats.items", "require": "{v}{k}", "empty": "hide", "fill": [
          { "text": ".summit-spotlight-number", "value": "{v}" },
          { "text": ".summit-spotlight-label", "value": "{k}" },
          { "text": ".summit-spotlight-meta", "value": "" }
        ] }
      ] },
      { "from": "whyjoin", "section": "why-attend",
        "intro": { "subheading": ".col-md-7 .page_hdng4 h2 > span", "heading": { "sel": ".col-md-7 .page_hdng4 h2", "skip": "span" }, "body": ".col-md-5 .page_hdng4 > p",
                   "cta": { "label": "a.agenda-cta > span:first-child", "link": "a.agenda-cta" } },
        "fill": [
        { "list": ".agenda-card", "items": "whyjoin.items", "require": "{t}{d}", "empty": "hide", "fill": [
          { "text": ".agenda-label", "value": "" },
          { "text": ".agenda-number", "value": "{##}" },
          { "text": ".agenda-card-title", "value": "{t}" },
          { "text": ".agenda-card-copy", "value": "{d}" }
        ] }
      ] },
      { "from": "attend", "section": "power-chain",
        "intro": { "subheading": "h2 > span", "heading": { "sel": "h2", "skip": "span" }, "body": ".page_hdng4 > p" },
        "fill": [
        { "list": ".power-chain-item", "items": "attend.items", "require": "{t|.}", "empty": "hide", "fill": [
          { "text": ".power-chain-role", "value": "{t|.}" },
          { "text": ".power-chain-domain", "value": "{d}" }
        ] }
      ] },
      { "from": "industries", "section": "industries",
        "intro": { "subheading": "h2 > span", "heading": { "sel": "h2", "skip": "span" } },
        "fill": [
        { "list": ".industry-card", "items": "industries.items", "require": "{t}", "empty": "hide", "fill": [
          { "text": ".industry-number", "value": "{##}" },
          { "text": ".industry-name", "value": "{t}" }
        ] }
      ] },
      { "from": "faq", "section": "faq",
        "intro": { "heading": { "sel": "h2", "skip": "span" } },
        "fill": [
        { "list": ".faq-item", "items": "faq.items", "require": "{t}{d}", "empty": "hide", "fill": [
          { "text": ".faq-number", "value": "{##}" },
          { "text": ".faq-question-text", "value": "{t}" },
          { "text": ".faq-answer", "value": "{d}" }
        ] }
      ] },
      { "from": "contact", "section": "contact-us",
        "intro": { "heading": ".page_hdng4 h2" },
        "fill": [
        { "list": ".flex-width-auto > .col-md-6", "items": "contact.blocks", "empty": "hide", "fill": [
          { "text": ".line-1", "value": "{t}", "empty": "remove" },
          { "list": ".contact-box", "items": "people", "empty": "hide", "fill": [
            { "text": ".name", "value": "{n}", "empty": "remove" },
            { "text": "a.email", "value": "{e}", "empty": "remove:span.email" },
            { "attr": "a.email", "name": "href", "value": "mailto:{e}" },
            { "text": "a.phone", "value": "{p}", "empty": "remove:span.phone" },
            { "attr": "a.phone", "name": "href", "value": "tel:{p}" }
          ] }
        ] }
      ] }
    ]
  },

  "layout": {
    "notes": "Which sections an event's own narrative order can touch. pinStart/pinEnd never move — the hero always opens the page and Contact/About-publisher always close it, matching every real ET microsite. Everything else is free for RevampCanvas.mount()'s sectionOrder option to resequence (see create-event.html's autoPersonalizeDesign() and requestAiDesign() — Gemini proposes a coherent order, not a blind shuffle) so two TECH500 events don't read as the identical page with different words.",
    "pinStart": ["banner"],
    "pinEnd": ["contact-us", "about-us"]
  },

  "sectionsNotes": "repeat =the section's repeating cards for the editor's Layout items: item = selector for one card (its parent is the list), label = what the list shows for it. toggle = items that open on click (an accordion): item, the class that opens it, and the element whose aria-expanded follows; the editor opens one when something inside it is clicked, so its hidden part can be edited.",
  "sections": [
    { "id": "banner",              "name": "Banner",                         "etId": null,     "widget": "et-banner" },
    { "id": "why-now",             "name": "Why now",                        "etId": "288831", "repeat": { "item": ".why-now-card", "label": "h4" } },
    { "id": "overview",            "name": "What is Tech500",                "etId": "288840" },
    { "id": "power-chain",         "name": "The Power Chain",                "etId": "288827", "repeat": { "item": ".power-chain-insight", "label": ".power-chain-insight-text" } },
    { "id": "summit-spotlight",    "name": "Summit spotlight",               "etId": "288850", "repeat": { "item": ".summit-spotlight-card", "label": ".summit-spotlight-label" } },
    { "id": "why-attend",          "name": "Be in the room",                 "etId": "288830", "repeat": { "item": ".agenda-card", "label": ".agenda-card-title" } },
    { "id": "industries",          "name": "Industries in the room",         "etId": "288832", "repeat": { "item": ".industry-card", "label": ".industry-name" } },
    { "id": "strategic-influence", "name": "Beyond sponsorship",             "etId": "288858", "repeat": { "item": ".strategic-influence-btn", "label": ".strategic-influence-btn" } },
    { "id": "faq",                 "name": "Frequently asked questions",     "etId": "288835", "script": true, "repeat": { "item": ".faq-item", "label": ".faq-question-text" },
      "toggle": { "item": ".faq-item", "open": "active", "expanded": ".faq-question" } },
    { "id": "contact-us",          "name": "Contact us",                     "etId": null,     "repeat": { "item": ".flex-width-auto > .col-md-6", "label": ".line-1" } },
    { "id": "about-us",            "name": "About ETCIO",                    "etId": null }
  ]
}
